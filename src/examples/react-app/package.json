{
  "name": "@map-of-science/react-app",
  "version": "0.0.0",
  "description": "Example React app template",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "vitest --project=unit",
    "test:integration": "vitest --project=integration"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@map-of-science/eslint": "workspace:*",
    "@map-of-science/typescript": "workspace:*",
    "@map-of-science/vitest": "workspace:*",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^9.13.0",
    "happy-dom": "^20.0.11",
    "typescript": "~5.6.2",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  }
}
