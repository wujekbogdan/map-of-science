{
  "name": "@map-of-science/react-app",
  "version": "0.1.2",
  "description": "Example React app template",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "vitest --project=unit",
    "test:integration": "vitest --project=integration",
    "test:browser": "vitest --project=browser"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@map-of-science/eslint": "workspace:*",
    "@map-of-science/typescript": "workspace:*",
    "@map-of-science/vitest": "workspace:*",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser-playwright": "4.1.5",
    "eslint": "^9.39.4",
    "happy-dom": "^20.0.11",
    "playwright": "1.59.1",
    "typescript": "~5.6.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vitest-browser-react": "2.2.0"
  }
}
