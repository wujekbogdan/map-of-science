{
  "name": "@map-of-science/cli",
  "version": "0.0.0",
  "description": "CLI for map-of-science operations",
  "type": "module",
  "private": true,
  "bin": {
    "cli": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "build:exe": "pkg --config pkg.json dist/mos-cli.cjs",
    "lint": "eslint",
    "typecheck": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.mjs",
    "test:unit": "vitest --project=unit",
    "test:integration": "vitest --project=integration"
  },
  "dependencies": {
    "@map-of-science/cluster-embedder": "workspace:*",
    "@map-of-science/cluster-namer": "workspace:*",
    "@map-of-science/embeddings": "workspace:*",
    "@map-of-science/eto-pdf-parser": "workspace:*",
    "@map-of-science/logger": "workspace:*",
    "@map-of-science/openalex": "workspace:*",
    "@map-of-science/package": "workspace:*",
    "@map-of-science/parsers": "workspace:*",
    "@map-of-science/rate-limiter": "workspace:*",
    "@map-of-science/text-generator": "workspace:*",
    "@map-of-science/vector-store": "workspace:*",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@map-of-science/eslint": "workspace:*",
    "@map-of-science/tsdown": "workspace:*",
    "@map-of-science/typescript": "workspace:*",
    "@map-of-science/vitest": "workspace:*",
    "@types/node": "^22.15.18",
    "@yao-pkg/pkg": "^6.11.0",
    "eslint": "^9.13.0",
    "testcontainers": "^11.10.0",
    "tmp-promise": "^3.0.3",
    "tsdown": "^0.16.8",
    "tsx": "^4.20.3",
    "typescript": "~5.6.2",
    "vitest": "^4.0.15"
  }
}
