{
  "name": "@map-of-science/test-utils",
  "version": "0.2.1",
  "description": "Shared testing utilities",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest --project=unit",
    "test:integration": "vitest --project=integration"
  },
  "devDependencies": {
    "@map-of-science/eslint": "workspace:*",
    "@map-of-science/typescript": "workspace:*",
    "@map-of-science/vitest": "workspace:*",
    "@types/node": "^24.12.2",
    "testcontainers": "^11.10.0",
    "typescript": "~5.6.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "msw": "^2.12.4"
  }
}
